MODEL_ID=Pro/zai-org/GLM-5.1
API_BASE=https://api.siliconflow.cn/v1/
API_KEY=your-api-key-here

# Docker 沙箱：默认启用。只有本机开发、不想装 Docker 时才设为 0（脚本会直接在本机执行，没有隔离）
USE_DOCKER=1
DOCKER_IMAGE=agent-sandbox:latest
# 联网 skill 的出口：proxy（默认，经出口代理，访问不到内网）或 direct（直接接默认网桥，仅调试）
SANDBOX_EGRESS=proxy
# 所在网络本身要经代理才能访问外网时，填上游 HTTP 代理。
# 注意要填容器里能访问到的地址：宿主机上的代理写 host.docker.internal，不能写 127.0.0.1
# EGRESS_UPSTREAM_PROXY=http://host.docker.internal:8118
# 可选：只允许联网 skill 访问这些域名（含子域），逗号分隔；不设则放行所有公网域名
# EGRESS_ALLOW_DOMAINS=
# 构建 skill 依赖镜像时用的 pip 源
SANDBOX_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# 容器运行时：runc（默认）或 runsc（gVisor，Linux 生产环境推荐）
SANDBOX_RUNTIME=runc
# 设为 production 后必须 USE_DOCKER=1，禁止在宿主机直接执行脚本
AGENT_ENV=development

# 调用方可选的其他模型（逗号分隔），与 MODEL_ID 共用 API_BASE 和 API_KEY。
# 也可以直接把多个模型写在 MODEL_ID 里用逗号分隔，第一个是默认模型
ALLOWED_MODELS=

# 鉴权：用户存在数据库里，用 `python -m core.auth add <用户名> [--admin]` 管理
# 仅本机开发：设为 1 跳过鉴权（AGENT_ENV=production 时不允许）
AUTH_DISABLED=0

# 数据库：默认是项目下的 SQLite 文件 data/agent.db。多副本部署时指向 Postgres（需要 pip install "psycopg[binary]"）
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/agent

# 文件存储：会话的上传文件、中间文件和产物。local（默认，目录 data/files）或 s3
FILE_STORE=local
# FILE_STORE_DIR=data/files
# FILE_STORE=s3 时（需要 pip install boto3；私有化部署可用 MinIO）：
# S3_BUCKET=agent-files
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# 脚本运行时的工作副本目录，默认是项目下的 workspaces/
# WORKSPACES_DIR=

# 会话与限流（每用户）
# 会话空闲多少秒后回收它的沙箱和工作副本（内容仍在数据库和文件存储里，随时可恢复）
SESSION_IDLE_TTL=1800
# 同时保留沙箱和工作副本的会话数；超出时回收最久未用的，不会拒绝请求
MAX_SESSIONS_PER_USER=5
# 会话多少天不用后连同文件一起删除，0 为永久保留
SESSION_RETENTION_DAYS=30
# 是否同时把每次运行的轨迹写成 trajectories/*.jsonl（数据库里总是有一份）
TRAJECTORY_JSONL=1
MAX_CONCURRENT_RUNS_PER_USER=2
RATE_LIMIT_PER_MINUTE=30

# 单次运行的预算：任一用完就停止，并让模型交代做完了什么、还剩什么
MAX_STEPS=15
RUN_TOKEN_BUDGET=300000
RUN_TIME_BUDGET=300
# 每次调用模型时放进去的历史上限（字符数）；超出时压缩较早的内容，完整记录仍保存在数据库里
CONTEXT_BUDGET_CHARS=40000

# 运行队列：入口只负责排队，由 worker 执行
# embedded（默认）：Web UI / API 进程里自带 worker；external：另起 `python -m core.worker`，入口进程不执行任务、不碰 Docker
WORKER_MODE=embedded
WORKER_THREADS=2
# worker 的租约（秒）：这么久没续租就视为 worker 已不在，它的任务标为中断
RUN_LEASE_SECONDS=60
# 排队这么久（秒）还没有 worker 领取，就判为出错
QUEUE_TIMEOUT=600
